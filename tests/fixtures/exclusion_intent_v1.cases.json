    },
    {
      "id": "quoted-negation",
      "query": "Find documentation for \"not supported\" responses",
      "positive_query": "Find documentation for \"not supported\" responses",
      "exclusion_clauses": []
    },
    {
      "id": "ambiguous-negation",
      "query": "The feature is not necessarily disabled",
      "positive_query": "The feature is not necessarily disabled",
      "exclusion_clauses": []
