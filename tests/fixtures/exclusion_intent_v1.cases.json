  "search_cases": [
    {
      "id": "english-limit-backfill",
      "query": "deployment without Docker",
      "limit": 2,
      "documents": [
        {
          "node_id": "a-docker",
          "text": "deployment Docker containers"
        },
        {
          "node_id": "b-podman",
          "text": "deployment Podman containers"
        },
        {
          "node_id": "c-release",
          "text": "deployment release process"
        }
      ],
      "expected_returned_node_ids": [
        "b-podman",
        "c-release"
      ],
      "expected_excluded_node_ids": [
        "a-docker"
      ]
    },
    {
      "id": "japanese-exclusion",
      "query": "認証設定、Cookieを除外",
      "limit": 2,
      "documents": [
        {
          "node_id": "a-cookie",
          "text": "認証設定でCookieを使用する"
        },
        {
          "node_id": "b-token",
          "text": "認証設定でtokenを使用する"
        }
      ],
      "expected_returned_node_ids": [
        "b-token"
      ],
      "expected_excluded_node_ids": [
        "a-cookie"
      ]
    },
    {
      "id": "document-negates-exclusion",
      "query": "editor without Rust",
      "limit": 2,
      "documents": [
        {
          "node_id": "a-safe",
          "text": "editor built without Rust dependencies"
        },
        {
          "node_id": "b-rust",
          "text": "editor embeds Rust tooling"
        },
        {
          "node_id": "c-trust",
          "text": "editor trust policy"
        }
      ],
      "expected_returned_node_ids": [
        "a-safe",
        "c-trust"
      ],
      "expected_excluded_node_ids": [
        "b-rust"
      ]
    }
  ]
}
