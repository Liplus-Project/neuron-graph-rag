    "model_forward_inference_count": {"const": 0},
    "retry_count": {"const": 0},
    "expected_source_id": {"type": "string", "minLength": 1},
    "corpus_document_count": {"const": 93},
    "cutoff": {"const": 20},
    "primary_success": {"type": "boolean"},
    "primary_success_arms": {"type": "array", "items": {"enum": ["structural_max", "body_centroid", "structural_centroid"]}, "uniqueItems": true},
