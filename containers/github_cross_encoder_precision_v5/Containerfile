FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HOME=/opt/ngr-v5/model-cache \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/ngr-v5

COPY tests/fixtures/github_cross_encoder_precision_v5.requirements.lock /opt/ngr-v5/requirements.lock
RUN python -m pip install \
      --ignore-installed \
      --only-binary=:all: \
      --require-hashes \
      --report /opt/ngr-v5/dependency-report.json \
      --requirement /opt/ngr-v5/requirements.lock

COPY containers/github_cross_encoder_precision_v5/validate_runtime.py /opt/ngr-v5/validate_runtime.py

ENTRYPOINT ["python", "/opt/ngr-v5/validate_runtime.py"]
